{
  "manifest_version": 3,
  "name": "Forgot AI",
  "version": "1.0.0",
  "description": "Save anything now. Find it later. Save pages, text and screenshots to your Forgot AI memory.",
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "contextMenus", "storage"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Forgot AI", "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "side_panel": { "default_path": "sidepanel.html" }
}
