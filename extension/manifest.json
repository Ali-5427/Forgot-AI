{
  "manifest_version": 3,
  "name": "Forgot AI",
  "version": "1.0.0",
  "description": "Save anything now. Find it later. Save pages, text and screenshots to your Forgot AI memory.",
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Forgot AI" },
  "side_panel": { "default_path": "sidepanel.html" }
}
